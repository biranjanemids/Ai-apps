# Meta WhatsApp Cloud API
# Get from: https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# Groq AI API — FREE, no credit card required
# Sign up at: https://console.groq.com  →  API Keys  →  Create API Key
# Free tier: 500K tokens/day, 6K tokens/min — more than enough for 200+ daily chats
GROQ_API_KEY=your_groq_api_key

# Product Data — no API keys needed
# Uses: Amazon/Flipkart web scraping (cheerio) + Myntra internal gateway API
# Set USE_MOCK_DATA=true to bypass all scraping (instant demo mode, no internet needed)
USE_MOCK_DATA=false

# Server
PORT=3000
NODE_ENV=development
