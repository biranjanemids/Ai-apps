# Meta WhatsApp Cloud API
# Get from: https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# Meta App Secret — used to verify webhook payload signatures (X-Hub-Signature-256)
# Get from: https://developers.facebook.com > your app > App Settings > Basic > App Secret
# REQUIRED in production (NODE_ENV=production refuses to start without it)
WHATSAPP_APP_SECRET=your_meta_app_secret

# Groq AI API — FREE, no credit card required
# Sign up at: https://console.groq.com  →  API Keys  →  Create API Key
# Free tier: 500K tokens/day, 6K tokens/min — more than enough for 200+ daily chats
GROQ_API_KEY=your_groq_api_key

# ── Product Data ──────────────────────────────────────────────────────────────
# RECOMMENDED: real, authenticated live data via SerpApi (Google Shopping India)
# Sign up free at https://serpapi.com → your API key (free tier: 100 searches/month)
# With this key set, searches return REAL products, prices, and buy links across
# Amazon/Flipkart/Myntra/Meesho/Nykaa/Ajio in one authenticated API call.
SERPAPI_KEY=

# Fallback chain: SerpApi → per-platform scrapers → demo catalog.
# Set USE_MOCK_DATA=true to force demo mode (instant, no internet/keys needed).
USE_MOCK_DATA=false

# Server
PORT=3000
NODE_ENV=development
