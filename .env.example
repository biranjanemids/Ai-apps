# Meta WhatsApp Cloud API
# Get from: https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# Meta App Secret — used to verify webhook payload signatures (X-Hub-Signature-256)
# Get from: https://developers.facebook.com > your app > App Settings > Basic > App Secret
# REQUIRED in production (NODE_ENV=production refuses to start without it)
WHATSAPP_APP_SECRET=your_meta_app_secret

# ── AI Providers (multi-provider fallback chain) ─────────────────────────────
# The bot rotates providers automatically on rate limits/outages:
#   Groq → Gemini → Cerebras → OpenRouter → Groq(8b)
# Only providers with a key set participate. All are FREE tiers.

# Groq — https://console.groq.com (free: ~500K tokens/day, 6K tokens/min)
GROQ_API_KEY=your_groq_api_key

# Google Gemini — https://aistudio.google.com → Get API key
# Default model is the rolling alias 'gemini-flash-latest' (pinned versions
# get retired for new users). Override with GEMINI_MODEL if needed.
GEMINI_API_KEY=

# Cerebras — https://cloud.cerebras.ai (free tier, very fast)
# Default model: gpt-oss-120b. Override with CEREBRAS_MODEL if their
# catalog changes (check https://inference-docs.cerebras.ai/models).
CEREBRAS_API_KEY=

# OpenRouter — https://openrouter.ai/keys (free :free model variants)
OPENROUTER_API_KEY=

# ── Product Data ──────────────────────────────────────────────────────────────
# RECOMMENDED: real, authenticated live data via SerpApi (Google Shopping India)
# Sign up free at https://serpapi.com → your API key (free tier: 100 searches/month)
# With this key set, searches return REAL products, prices, and buy links across
# Amazon/Flipkart/Myntra/Meesho/Nykaa/Ajio in one authenticated API call.
SERPAPI_KEY=

# Fallback chain: SerpApi → per-platform scrapers → demo catalog.
# Set USE_MOCK_DATA=true to force demo mode (instant, no internet/keys needed).
USE_MOCK_DATA=false

# ── Affiliate & Monetization ──────────────────────────────────────────────────
# Amazon Associates affiliate tag (India tags end in -21)
# Sign up at: https://affiliate-program.amazon.in (needs a website — use your
# GitHub Pages landing site). Applied to all amazon.in links as `tag=`.
AMAZON_AFFILIATE_TAG=

# Cuelinks Channel ID (CID) — one ID covers Flipkart, Myntra, Ajio, Nykaa,
# Meesho and 1,000+ Indian merchants via link-wrapping.
# Sign up at: https://www.cuelinks.com → after approval find your CID under
# My Account / any generated link (the number in linksredirect.com/?cid=XXXXX).
# (Flipkart's own affiliate program is closed to new signups — this replaces it.)
CUELINKS_CID=

# Admin phone number for viewing metrics (WhatsApp format: country code + number)
# Used to access /metrics command
ADMIN_PHONE_NUMBER=

# Server
PORT=3000
NODE_ENV=development
