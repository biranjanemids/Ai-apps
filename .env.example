# Meta WhatsApp Cloud API
# Get from: https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# Anthropic Claude API
# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# Product Data
# No API keys needed — uses web scraping (Amazon, Flipkart) and Myntra gateway
# Set USE_MOCK_DATA=true to bypass all scraping and use built-in demo data instead
USE_MOCK_DATA=false

# Server
PORT=3000
NODE_ENV=development
