# Meta WhatsApp Cloud API
# Get from: https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# Anthropic Claude API
# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# RapidAPI Key (single key works for Amazon, Flipkart, Myntra APIs)
# Get from: https://rapidapi.com/hub
# Subscribe to:
#   - "Real-Time Amazon Data" (real-time-amazon-data.p.rapidapi.com)
#   - "Flipkart" (flipkart-api.p.rapidapi.com)
#   - "Myntra Fashion Products" (myntra-fashion-products.p.rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key

# Server
PORT=3000
NODE_ENV=development
