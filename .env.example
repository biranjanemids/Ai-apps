# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info                      # trace | debug | info | warn | error

# ── Auth ─────────────────────────────────────────────────────────────────────
# Bearer token required on all /v1/* endpoints. Leave empty to disable auth.
API_KEY=your-secret-api-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Upstream timeouts & retries ───────────────────────────────────────────────
REQUEST_TIMEOUT_MS=120000           # ms — AbortSignal timeout for upstream calls
MAX_RETRIES=2                       # retries on 429 / 503 upstream errors

# ── Provider API Keys ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...
GROK_API_KEY=xai-...

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
