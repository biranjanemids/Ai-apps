#!/bin/sh
### BEGIN INIT INFO
# Provides:          ssh-devtool
# Required-Start:    $network $syslog
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: USB SSH Devtool — keep SSH alive on ThinOS
### END INIT INFO

SSH_CONF="/etc/ssh/sshd_config"

case "$1" in
  start)
    echo "Starting ssh-devtool ..."
    if command -v systemctl >/dev/null 2>&1; then
      systemctl start ssh 2>/dev/null || systemctl start sshd 2>/dev/null || true
    else
      for sshd in /usr/sbin/sshd /sbin/sshd; do
        [ -x "$sshd" ] && "$sshd" -f "$SSH_CONF" && break
      done
    fi
    ;;
  stop)
    echo "Stopping ssh-devtool ..."
    ;;
  restart|reload)
    $0 stop; $0 start
    ;;
  status)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl status ssh 2>/dev/null || systemctl status sshd 2>/dev/null
    else
      pgrep sshd >/dev/null && echo "sshd is running." || echo "sshd is NOT running."
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
