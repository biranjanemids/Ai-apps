# ── Phone dashboard ───────────────────────────────────────────────────────────
# REQUIRED. Long random secret; you type it once on your phone.  openssl rand -hex 24
DASHBOARD_TOKEN=
PORT=8787

# ── Your company — NEVER apply here ───────────────────────────────────────────
# Comma-separated. Put your employer AND its parent / group / subsidiaries and any
# short names recruiters use (e.g. "Tata Consultancy Services,TCS,Tata Group").
# Your current employer from your LinkedIn profile is also added automatically.
EXCLUDED_COMPANIES=
AUTO_EXCLUDE_CURRENT_EMPLOYER=true

# ── Your resume (PDF or .txt) — used for matching and uploaded if a form asks ──
RESUME_PATH=./resume.pdf
# Override the experience computed from your profile, e.g. 6.5
YEARS_EXPERIENCE=

# ── Search ────────────────────────────────────────────────────────────────────
JOB_LOCATION=Bengaluru, Karnataka, India
JOB_GEO_ID=105214831
# Blank = derived from your LinkedIn headline / current titles
KEYWORDS=
EXCLUDED_TITLE_WORDS=intern,internship,trainee
# r86400 = 24h, r604800 = 1 week, r2592000 = 1 month
POSTED_WITHIN=r604800
MAX_JOBS_SCANNED_PER_KEYWORD=50

# ── Applying ──────────────────────────────────────────────────────────────────
# Start with DRY_RUN=true: forms are filled but never submitted. Flip to live
# from the phone dashboard once you've checked the matches.
DRY_RUN=true
MIN_MATCH_SCORE=55
MAX_APPLICATIONS_PER_RUN=15
# Keep this modest — LinkedIn restricts accounts that apply too fast.
MAX_APPLICATIONS_PER_DAY=40
# 0 = only when you tap "Run" on the phone; e.g. 240 = every 4 hours
RUN_EVERY_MINUTES=0

# ── Optional ──────────────────────────────────────────────────────────────────
# Free Groq key (https://console.groq.com) → AI also rates each job vs your resume
GROQ_API_KEY=
# Push notifications: install the ntfy app on your phone and subscribe to this topic
# (pick something unguessable)
NTFY_TOPIC=
# Instead of `npm run login` (e.g. on a headless server): value of the li_at cookie
LINKEDIN_LI_AT=
HEADLESS=true
CHROME_PATH=
ANSWERS_PATH=./answers.json
