{
  "name": "linkedin-job-agent",
  "version": "1.0.0",
  "description": "Phone-controlled LinkedIn job agent: finds Bengaluru jobs matching your profile and Easy-Applies, never to excluded (parent) companies",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "login": "node dist/cli.js login",
    "sync-profile": "node dist/cli.js sync-profile",
    "run": "node dist/cli.js run",
    "start": "node dist/cli.js serve",
    "test": "tsc && node --test dist/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
