# ── AI Provider API Keys ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GROK_API_KEY=xai-...

# ── Local Model Runners ──────────────────────────────────────────────────────
