<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Agent host. Targets net8.0 so the core (comm, orchestrator, install state
    machine) builds and runs cross-platform for local demos/tests. The real
    Windows interop (UWF/WMI, installers) lives behind interfaces in Platform/
    with stub implementations selected at runtime when not on Windows.
    For a production Windows build, add the Microsoft.Windows.Compatibility
    package and a net8.0-windows TFM, and register the Win32/WMI implementations.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ltsc.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
    <PackageReference Include="Grpc.Net.Client" Version="2.63.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ltsc.Contracts\Ltsc.Contracts.csproj" />
  </ItemGroup>

</Project>
